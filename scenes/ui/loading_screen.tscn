[gd_scene load_steps=7 format=3 uid="uid://loading_screen"]

[ext_resource type="Script" path="res://scripts/ui/loading_screen.gd" id="1_loadscr"]

[sub_resource type="StyleBoxFlat" id="Style_card"]
bg_color = Color(0.08, 0.1, 0.15, 0.85)
border_width_left = 3
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.85, 0.58, 0.1, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="Style_tip"]
bg_color = Color(0.06, 0.08, 0.12, 0.9)
border_width_left = 3
border_color = Color(0.2, 0.7, 0.9, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="Style_progress_bg"]
bg_color = Color(0.05, 0.06, 0.09, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.25, 0.3, 0.38, 0.8)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="Style_progress_fill"]
bg_color = Color(0.95, 0.62, 0.12, 1)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="Theme" id="Theme_progress"]
ProgressBar/styles/background = SubResource("Style_progress_bg")
ProgressBar/styles/fill = SubResource("Style_progress_fill")

[node name="LoadingScreen" type="Control" node_paths=PackedStringArray("lbl_title", "lbl_subtitle", "lbl_operator_info", "lbl_weapon_info", "lbl_status", "lbl_percent", "progress_bar", "lbl_tip", "tip_timer", "bg_texture")]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_loadscr")
lbl_title = NodePath("MainMargin/VBoxMain/HeaderBox/MapTitle")
lbl_subtitle = NodePath("MainMargin/VBoxMain/HeaderBox/MapSubtitle")
lbl_operator_info = NodePath("MainMargin/VBoxMain/CardLoadout/Margin/VBoxLoadout/OperatorInfo")
lbl_weapon_info = NodePath("MainMargin/VBoxMain/CardLoadout/Margin/VBoxLoadout/WeaponInfo")
lbl_status = NodePath("MainMargin/VBoxMain/FooterBox/StatusRow/StatusLabel")
lbl_percent = NodePath("MainMargin/VBoxMain/FooterBox/StatusRow/PercentLabel")
progress_bar = NodePath("MainMargin/VBoxMain/FooterBox/ProgressBar")
lbl_tip = NodePath("MainMargin/VBoxMain/FooterBox/CardTip/Margin/TipLabel")
tip_timer = NodePath("TipTimer")
bg_texture = NodePath("BgTexture")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.05, 0.08, 1)

[node name="BgTexture" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
expand_mode = 1
stretch_mode = 6
modulate = Color(0.65, 0.72, 0.85, 0.5)

[node name="BgDarkOverlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.05, 0.08, 0.78)

[node name="AccentTop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 4.0
grow_horizontal = 2
color = Color(0.9, 0.6, 0.12, 1)

[node name="AccentBottom" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -4.0
grow_horizontal = 2
grow_vertical = 0
color = Color(0.18, 0.75, 0.95, 0.8)

[node name="MainMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 60
theme_override_constants/margin_top = 45
theme_override_constants/margin_right = 60
theme_override_constants/margin_bottom = 40

[node name="VBoxMain" type="VBoxContainer" parent="MainMargin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="HeaderBox" type="VBoxContainer" parent="MainMargin/VBoxMain"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PreHeader" type="Label" parent="MainMargin/VBoxMain/HeaderBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.8, 1, 1)
theme_override_font_sizes/font_size = 13
text = "OPERATIONAL DEPLOYMENT // SISTEMA TÁTICO v4.7"

[node name="MapTitle" type="Label" parent="MainMargin/VBoxMain/HeaderBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.72, 0.15, 1)
theme_override_font_sizes/font_size = 34
text = "NUK3TOWN BO3 (FUTURISTA 2065)"

[node name="MapSubtitle" type="Label" parent="MainMargin/VBoxMain/HeaderBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.65, 0.72, 0.8, 1)
theme_override_font_sizes/font_size = 14
text = "CALL OF DUTY EXPERIENCE — COMBATE URBANO MULTIPLAYER"

[node name="SpacerMid1" type="Control" parent="MainMargin/VBoxMain"]
layout_mode = 2
size_flags_vertical = 3

[node name="CardLoadout" type="PanelContainer" parent="MainMargin/VBoxMain"]
layout_mode = 2
theme_override_styles/panel = SubResource("Style_card")

[node name="Margin" type="MarginContainer" parent="MainMargin/VBoxMain/CardLoadout"]
layout_mode = 2
theme_override_constants/margin_left = 22
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 22
theme_override_constants/margin_bottom = 16

[node name="VBoxLoadout" type="VBoxContainer" parent="MainMargin/VBoxMain/CardLoadout/Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="LoadoutHeader" type="Label" parent="MainMargin/VBoxMain/CardLoadout/Margin/VBoxLoadout"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.75, 0.2, 1)
theme_override_font_sizes/font_size = 12
text = "DADOS DE OPERAÇÃO & CARGA SELECIONADA:"

[node name="OperatorInfo" type="Label" parent="MainMargin/VBoxMain/CardLoadout/Margin/VBoxLoadout"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_font_sizes/font_size = 15
text = "OPERADOR: SEAL TEAM 6 (URBAN) [CT]  |  CLASSE: ASSALTO"

[node name="WeaponInfo" type="Label" parent="MainMargin/VBoxMain/CardLoadout/Margin/VBoxLoadout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.72, 0.8, 0.88, 1)
theme_override_font_sizes/font_size = 14
text = "CARGA BÉLICA: ACR 6.8  |  SECUNDÁRIA: PISTOLA C19  |  CORPO A CORPO: FACA DE COMBATE"

[node name="SpacerMid2" type="Control" parent="MainMargin/VBoxMain"]
layout_mode = 2
size_flags_vertical = 3

[node name="FooterBox" type="VBoxContainer" parent="MainMargin/VBoxMain"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="CardTip" type="PanelContainer" parent="MainMargin/VBoxMain/FooterBox"]
layout_mode = 2
theme_override_styles/panel = SubResource("Style_tip")

[node name="Margin" type="MarginContainer" parent="MainMargin/VBoxMain/FooterBox/CardTip"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 10

[node name="TipLabel" type="Label" parent="MainMargin/VBoxMain/FooterBox/CardTip/Margin"]
layout_mode = 2
theme_override_colors/font_color = Color(0.88, 0.92, 0.98, 1)
theme_override_font_sizes/font_size = 13
text = "💡 DICA TÁTICA: Disparos na cabeça e no tronco superior causam dano crítico substancial."
autowrap_mode = 2

[node name="StatusRow" type="HBoxContainer" parent="MainMargin/VBoxMain/FooterBox"]
layout_mode = 2

[node name="StatusLabel" type="Label" parent="MainMargin/VBoxMain/FooterBox/StatusRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.55, 0.65, 0.75, 1)
theme_override_font_sizes/font_size = 13
text = "Carregando malhas geométricas e texturas de alta definição..."

[node name="PercentLabel" type="Label" parent="MainMargin/VBoxMain/FooterBox/StatusRow"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.7, 0.15, 1)
theme_override_font_sizes/font_size = 16
text = "0%"

[node name="ProgressBar" type="ProgressBar" parent="MainMargin/VBoxMain/FooterBox"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
theme = SubResource("Theme_progress")
show_percentage = false

[node name="TipTimer" type="Timer" parent="."]
wait_time = 3.5
autostart = true
